# ---- Google Drive への自動アップロード（lib/drive_upload.py, rclone） ----

# アップロード先（rclone のリモート名:Drive内のフォルダーパス）。未設定ならアップロードしない。
# 作品ごとに <PY5_UPLOAD_REMOTE>/<work_name>/ へ静止画をコピー、動画を移動する。
# PY5_UPLOAD_REMOTE=gdrive:Media/py5-media-art

# 0 で無効（動画を sketch/<work_name>/ に残す）。
# PY5_UPLOAD=0

# 並行アップロード数とDriveアップロードチャンクサイズ（メモリ使用量は約 transfers × chunk size）。
# PY5_UPLOAD_TRANSFERS=8
# PY5_UPLOAD_CHUNK_SIZE=64M
